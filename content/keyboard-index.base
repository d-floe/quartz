filters:
  and:
    - file.tags.contains("Keyboard")
views:
  - type: cards
    name: Keyboards
    order:
      - title
    sort:
      - property: title
        direction: ASC
    cardSize: 220
    imageFit: ""
    imageAspectRatio: 0.6
    image: note.image
  - type: table
    name: View
    order:
      - title
      - tags
    sort:
      - property: title
        direction: ASC
    columnSize:
      note.title: 244
